# docker compose 变量插值读取「项目根目录」的 .env，请把本文件复制为 .env 后填写真实值
# cp .env.example .env

# MySQL
MYSQL_ROOT_PASSWORD=你的MySQL_root密码
DB_USER=bookmall
DB_PASSWORD=你的业务账号密码
DB_NAME=bookmall

# 后端本地开发用（容器内会由 compose 覆盖成 mysql:3306）
DB_HOST=127.0.0.1
DB_PORT=3306

# DeepSeek 大模型
DEEPSEEK_API_KEY=你的DeepSeek_API_KEY
